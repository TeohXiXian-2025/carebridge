# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# With no VITE_FIREBASE_* values the app runs in DEMO MODE (sample data saved in your browser only).

# Firebase web config (public values, from Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Push notifications: Project settings → Cloud Messaging → Web Push certificates → public key
VITE_FIREBASE_VAPID_KEY=

# Optional email notifications via EmailJS (one template using {{to_email}}, {{subject}}, {{message}})
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# SERVER ONLY (Vercel env var, never commit): full JSON of a Firebase service account key.
# Used by api/notify.ts to send push notifications.
# FIREBASE_SERVICE_ACCOUNT=
