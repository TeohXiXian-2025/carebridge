# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# With no VITE_FIREBASE_* values the app runs in DEMO MODE (sample data saved in your browser only).

# Firebase web config (public values, from Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Push notifications: Project settings → Cloud Messaging → Web Push certificates → public key
VITE_FIREBASE_VAPID_KEY=

# ---- SERVER ONLY (Vercel env vars, never commit) ----
# Full JSON of a Firebase service account key. Needed for app (push) AND email notifications.
# FIREBASE_SERVICE_ACCOUNT=
# Mailbox that sends notification emails (use a dedicated Gmail + an App Password).
# SMTP_USER=carebridge.noreply@gmail.com
# SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), APP_URL (default: the site's own address)
